#!/bin/sh
# Commit'e giren içerik üzerinde repo denetimi (pnpm repo:check). Kurulum: pnpm hooks:install.
# Denetim çalışma ağacına değil COMMIT'E GİREN içeriğe koşar: indeks geçici dizine açılır; ağaçta duran
# ama commit'e girmeyen dosya (yarım iş, başka şeridin kodu) sonucu boyayamaz. Betik yalnız node
# yerleşikleri kullandığı için node_modules'suz kopyada koşar.

cd "$(git rev-parse --show-toplevel)" || exit 1

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT
git checkout-index -a --prefix="$tmp/" || exit 1

if ! node "$tmp/scripts/repo-check.mjs"; then
  echo ""
  echo "✗ Repo tutarsız — düzelt ya da bilinçliyse 'git commit --no-verify'."
  echo "  Not: denetim COMMIT'E GİREN içeriğe koştu."
  exit 1
fi
