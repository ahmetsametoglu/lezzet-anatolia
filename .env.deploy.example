# scripts/deploy.sh ayarı: cp .env.deploy.example .env.deploy (.env.deploy git'e girmez).
SSH_USER=root
SSH_HOST=
# Sunucudaki kök: releases/ (sürümler) · shared/ (env + derleme önbelleği) · current (yayındaki sürüm)
APP_DIR=/opt/lezzet
APP_USER=lezzet
# İlk satırı parola olan dosya (sshpass -f); boşsa SSH anahtarı kullanılır.
SSH_PASSWORD_FILE=~/.ssh/lezzet-test.pass
KEEP_RELEASES=3
