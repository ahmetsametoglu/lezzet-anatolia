# Kök .env — YALNIZ root araçları içindir:
#   (1) seed / set-role script'leri + entegrasyon testleri (Next.js dışı; `process.loadEnvFile('.env')`)
#   (2) `supabase start` — config.toml `env(...)` referansları (Google auth sağlayıcısı)
# Web ve backend kendi env'lerini apps/*/.env.local'de tutar → bkz. apps/web/.env.example.
# Uygulama-özel anahtarlar (Stripe, e-posta, AI…) ilgili app'in env.example'ına özelliğiyle eklenir.
# Yerel dev anahtarları: `supabase status -o env` çıktısından üretilir.

# --- Supabase (service-role; script + test RLS baypas) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Storage: Cloudflare R2 (S3-uyumlu; seed görselleri yükler) ---
# Referans proje deseni. Eksikse seed görselleri atlar (graceful). R2_PATH_PREFIX dev/prod izolasyonu
# (varsayılan 'dev'). Anahtarlar Cloudflare dashboard → R2 → API token'dan.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PATH_PREFIX=dev

# --- Google ile giriş (04-auth) — config.toml env(GOOGLE_CLIENT_ID/SECRET); Google Cloud'dan ---
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# --- Seed ---
# İlk admin e-postası (yoksa admin@lezzetanatolia.fr). Local'de OTP kodu Mailpit'e (54324) düşer.
SEED_ADMIN_EMAIL=
