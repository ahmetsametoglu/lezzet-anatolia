# Kök .env — script/backend içindir. Web uygulaması kendi env'ini apps/web/.env.local'de tutar
# (Next bunu native yükler). Yerel dev anahtarları `supabase status -o env` çıktısından üretilir.

# --- Supabase ---
# Tarayıcıya yalnız publishable key çıkar; secret key yalnız sunucuda (RLS baypas).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=

# --- Google ile giriş (04-auth) — Google Cloud'dan; girilince config.toml'da enabled=true ---
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# --- apps/backend ---
BACKEND_PORT=8787

# --- Stripe (07-siparis) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- E-posta sağlayıcı (14-bildirim — netleşecek) ---
EMAIL_PROVIDER_API_KEY=

# --- AI sağlayıcı (05/13/15/16) ---
AI_PROVIDER_API_KEY=
