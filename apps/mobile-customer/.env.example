# Yerel geliştirme örneği — kopyala: cp .env.example .env
# EXPO_PUBLIC_* değişkenleri Metro tarafından DERLEME anında bundle'a gömülür:
# buraya YALNIZ istemciye açık değerler yazılır (anon anahtar evet, secret ASLA).

# apps/mobile-api taban adresi (yerel port 3002). Cihazdan test ederken de `localhost` kalır: host'u kod, cihazın Metro'ya bağlandığı
# adresten çözer (`packages/mobile-kit/src/lib/env.ts`), elle yazılan LAN adresi router adres değiştirince sessizce kopar.
EXPO_PUBLIC_API_URL=http://localhost:3002

# Yerel Supabase (supabase start çıktısındaki API URL + anon/publishable key)
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_KEY=anon-anahtari-buraya

# Sitenin dış adresi, davet bağlantısının alan adı; dolunca uygulama `https://<alan-adı>/<dil>/davet/<kod>` adreslerini sahiplenir.
# Yerelde boş kalır, çünkü işletim sistemi uydurma alan adının başarısız doğrulamasını önbelleğe alır; boşken bağlantı tarayıcıda açılır.
EXPO_PUBLIC_SITE_URL=

# Stripe istemci anahtarı — cihazda kullanılır, `EXPO_PUBLIC_` öneki bilinçli (pakete girer).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Apple Pay tüccar kimliği (`app.config.ts`). Boşsa Apple Pay yapılandırması hiç eklenmez.
EXPO_PUBLIC_STRIPE_APPLE_MERCHANT_ID=

# Otomatik geliştirme girişi, yalnız `__DEV__` derlemesinde: boşken oturumsuz açılan uygulama seed'in müşteri hesabıyla girer, çünkü
# `db:refresh` oturumu gün boyu geçersizleştirir. `off` kapatır; giriş akışını (OTP, OAuth, onboarding) deneyen kapatmalı.
EXPO_PUBLIC_DEV_AUTOLOGIN=

# Google harita anahtarları: `app.config.ts` derlemede yerel harita yapılandırmasına yazar, JS paketine girmez (`EXPO_PUBLIC_`
# öneki yok). Kilit Android'de paket adı + imza SHA-1, iOS'ta bundle ID. BEKLEYEN(K.28): native harita henüz eklenmedi.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
