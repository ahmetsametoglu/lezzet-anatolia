# apps/web — Next.js uygulaması env örneği. Gerçek değerler apps/web/.env.local'de tutulur
# (git-ignored; Next bunu native yükler). Yerel dev anahtarları `supabase status -o env`'den üretilir.

# --- Supabase ---
# Tarayıcıya yalnız publishable key çıkar (NEXT_PUBLIC_*). Secret key YALNIZ sunucuda (RSC / Server
# Action → serviceDb, RLS baypas); tarayıcıya sızmamalı. Storage 'catalog' public bucket'ı (0006
# migration) da bu URL + secret ile kullanılır — görsel için ek anahtar gerekmez.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Storage: Cloudflare R2 (S3-uyumlu; katalog görselleri) ---
# Yükleme action'ı (sunucu) + signed okuma URL'i R2'yi kullanır (private bucket). Eksikse görsel
# yükleme/okuma graceful atlanır. R2_PATH_PREFIX dev/prod izolasyonu (varsayılan 'dev').
R2_ENDPOINT=
R2_ACCESS_KEY_ID=d9a166fa7aa873a56d9219780334f742
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PATH_PREFIX=dev
