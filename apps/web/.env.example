# apps/web env örneği; gerçek değerler git'e girmeyen apps/web/.env.local'de. Yerel Supabase anahtarları `supabase status -o env`'den.

# --- Supabase ---
# Tarayıcıya yalnız publishable anahtar çıkar (NEXT_PUBLIC_*); secret anahtar RLS'yi baypas ettiği için yalnız sunucuda kalır.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Storage: Cloudflare R2 (S3 uyumlu), iki kova ---
# Kimlik bilgileri ortak, ayrışan kova adı ve okuma yolu. R2_PATH_PREFIX dev/prod ayrımıdır ve iki kovada da uygulanır.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PATH_PREFIX=dev

# ── Kova 1: public, katalog görselleri ──
# Okuma imzasızdır, çünkü görsellerin paylaşılması ve aramaya girmesi istenir; imza önbelleği ve OG kartını kırardı.
R2_BUCKET_NAME=
# Kovaya bağlı özel alan adı (https://cdn.lezzetanatolie.com); görsel dönüşümü (`/cdn-cgi/image/…`) yalnız bu zone'da çalışır.
# Boşsa görseller gösterilmez; RSC'de çözüldüğü için NEXT_PUBLIC_ değildir ve CSP `img-src` kökünü kendiliğinden tanır.
R2_PUBLIC_BASE_URL=

# ── Kova 2: private, müşterinin yüklediği dosyalar ──
# Public adresi yoktur: okuma ve yükleme, sunucunun yetkiyi doğrulayıp ürettiği süreli imzalı adresle yapılır. Kovada Public Access
# açılmaz ve özel alan adı bağlanmaz; boşsa ek yükleme kapalı kalır.
R2_PRIVATE_BUCKET_NAME=

# --- Geliştirme kimlik baypası ---
# Operasyon guard'larını sahte admin'le atlar ve production derlemesinde hiçbir değerle açılmaz. Dev'de varsayılan açıktır, gerçek
# akışı denemek için 'false' yazılır.
DEV_AUTH_BYPASS=
# Baypasın baktığı profil, boşsa seed admin'i. Kurye ekranları kimliğe bağlı okur; kurye profilinin id'si yazılınca gün dolu görünür.
DEV_AUTH_BYPASS_USER_ID=

# --- Hızlı giriş kapısı: /auth/dev-login ---
# Baypastan farklı olarak gerçek oturum açar (magic-link jetonu üretir, mail gitmez), bu yüzden production derlemesinde de çalışır.
# Üç kilit: bu bayrak 'true', NEXT_PUBLIC_SITE_URL yerel adres ve istek yerel host'a gelmiş olmalı; gerçek dağıtımda yazılmaz.
DEV_LOGIN_ENABLED=

# --- E-posta: Resend ---
# Giriş kodu dahil bütün mail buradan çıkar. Anahtar yoksa gönderim atlanır ve sonuç `skipped` olur, "gitti" ile karışmaz.
# Ayarlar › Kurulum › Bağlantı anahtarları'ndan yazılan anahtar bu değerin yerine geçer.
RESEND_API_KEY=
# Gönderen adresi ("Lezzet Anatolie <bonjour@alan.fr>"), boşsa marka sabitinden kurulur. Alan adının SPF/DKIM kaydı Resend'de
# doğrulanmamışsa mail spam'e düşer.
RESEND_FROM=

# --- Site adresi ---
# Mail ve bildirim bağlantılarının tabanı; bildirim bir HTTP isteğinin içinde doğmayabildiği için istekten okunamaz. Boşsa üretim
# alanı varsayılır, yerelde doldurulmazsa bağlantı canlı siteye gider.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Ödeme sağlayıcı (Revolut) ---
# Merchant API anahtarı ve kip (`sandbox` deneme, `live` canlı); anahtar yoksa ödeme `provider_unavailable` döner ve stok ayrılmaz.
# Kart alanı tarayıcıda ödeme jetonuyla açılır, ayrı bir tarayıcı anahtarı gerekmez.
# Ayarlar › Kurulum › Bağlantı anahtarları'ndan yazılan anahtar bu değerin yerine geçer.
REVOLUT_SECRET_KEY=
REVOLUT_MODE=
# Webhook imza anahtarı (webhook kaydının `signing_secret`i); yoksa `/api/webhooks/revolut` 503 döner.
REVOLUT_WEBHOOK_SECRET=

# --- Meta webhook (WhatsApp + Messenger + Instagram, tek uç: /api/webhooks/meta) ---
# Her POST'un imzası bununla doğrulanır, yoksa uç 503 döner. Kaynak: developers.facebook.com → App settings → Basic → App secret.
META_APP_SECRET=
# Kurulum el sıkışmasının bizim seçtiğimiz dizesi; Meta panelindeki "Verify token" alanına aynısı yazılır. Yerelde tünel gerekir.
META_WEBHOOK_VERIFY_TOKEN=
# Sayfa jetonu: Messenger ve Instagram cevabının gönderimi ve gönderenin adı. Yoksa gönderim sistem jetonuna düşer, konuşma adsız açılır.
META_PAGE_ACCESS_TOKEN=
# WhatsApp gönderim jetonu; web ve backend aynı adı okur ki biri yapılandırılıp öteki susmasın. Boşsa gönderim reddedilir ve
# otomatik verilen kod satırdan geri alınır.
META_ACCESS_TOKEN=
# `pnpm whatsapp:smoke` betiğinin gönderen numarasının Meta kimliği (phone_number_id); sır değildir. Üretim gönderimi bunu okumaz,
# numarayı sohbetin kaydından alır.
META_TEST_PHONE_NUMBER_ID=
# Onaylı alıcı, E.164 biçiminde `+` ve tire olmadan (ör. 33612345678); listede olmayan numara `131030` hatası verir.
META_TEST_RECIPIENT=

# --- Push: Expo ---
# Opsiyonel: yalnız Expo hesabında "Enhanced Push Security" açıksa gerekir.
EXPO_ACCESS_TOKEN=

# --- Tarayıcı bildirimi (VAPID anahtar çifti) ---
# Üretme: node -e "console.log(require('web-push').generateVAPIDKeys())". Çift web, backend ve mobile-api'de aynı olmalı, çünkü
# abonelik açık anahtara bağlıdır; açık anahtar derlemede sayfaya gömülür ve boşsa bildirim kartı çizilmez.
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# --- Google Maps Platform ---
# Places (New) ve Address Validation anahtarı; sunucudan çağrılır, tarayıcıya inmez. Boşsa Almanya'da öneri çıkmaz ve form elle
# girişle çalışır; Fransa anahtarsızdır (BAN).
GOOGLE_MAPS_API_KEY=
# Tarayıcı anahtarı (kilit: HTTP yönlendirici, yalnız Map Tiles API): web haritasının karoları. BEKLEYEN(K.30): henüz okunmuyor.
GOOGLE_MAPS_BROWSER_API_KEY=

# --- Yapay zekâ (packages/ai) ---
# Kod model adı değil katman bilir (`cheap`/`standard`), model seçimi dağıtım kararıdır. AI_PROVIDER: anthropic (varsayılan) | google;
# yalnız seçilenin anahtarı gerekir, yoksa çeviri düğmesi "yapılandırılmamış" der.
AI_PROVIDER=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Katman modelleri, boşsa sağlayıcının varsayılanı. Müşteriye giden metin `standard`a, sınıflandırma işleri `cheap`e gider.
AI_MODEL_CHEAP=
AI_MODEL_STANDARD=

# --- Mobil uygulama ilişkilendirmesi (/.well-known/*) ---
# Davet bağlantısı uygulaması olanda uygulamada açılsın diye; üç değer de mağaza başvurusuyla doğar. Boşken dosya bilerek 404 döner,
# çünkü yer tutucu işletim sisteminin başarısız doğrulamayı önbelleğe almasına yol açar.

# iOS: <TAKIM_KİMLİĞİ>.com.lezzetanatolie.app
MOBILE_IOS_APP_ID=
# Android paket adı; apps/mobile-customer/app.config.ts ile aynı olmalı.
MOBILE_ANDROID_PACKAGE=
# Android imza sertifikasının SHA-256 parmak izi (AA:BB:CC:... biçiminde).
MOBILE_ANDROID_SHA256=

# --- Sendcloud / kargo ---
# Sağlayıcıyı kuran her süreç anahtarı kendi ortamında görmeli: web (ödeme teklifi), backend (webhook ve cron) ve mobile-api. Yoksa
# akış durur ve söyler: eşik altı kargo siparişi açılmaz, cron `not_configured` bırakır, mobil uç `503 shipping_provider_off` döner.
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=
# Opsiyonel: sağlayıcı adresi, boşsa `https://panel.sendcloud.sc`.
SENDCLOUD_API_BASE_URL=

# Next derleme dizini, boşsa `.next`. Paralel üretim kopyası `.next-prod` kullanır ki dev'in klasörüne dokunmasın.
NEXT_DIST_DIR=
