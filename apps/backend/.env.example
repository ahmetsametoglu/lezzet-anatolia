# apps/backend env örneği; gerçek değerler git'e girmeyen apps/backend/.env.local'de. Kök .env yalnız kök araçlarınındır
# (betik, test, supabase CLI).

# Dinlenecek port (yoksa 8787).
BACKEND_PORT=8787

# --- Supabase (service-role; cron'lar RLS baypasıyla yazar) ---
# Backend Next.js değildir, env'i kendi .env.local'inden okur. Eksikse `serviceDb()` ilk cron turunda "Supabase env eksik" hatası verir.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Yapay zekâ (packages/ai) ---
# Çeviri ve AI destek turu kullanır; anahtar yoksa ikisi de turu atlar ve çeviri hiçbir satırı damgalamaz ki anahtar gelince geçmiş
# çevrilebilsin. AI_PROVIDER: anthropic (varsayılan) | google; yalnız seçilenin anahtarı gerekir.
AI_PROVIDER=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Katman modelleri, boşsa sağlayıcının varsayılanı. Çeviri `cheap`e, müşteriye giden metin (destek taslağı, özerk cevap) `standard`a gider.
AI_MODEL_CHEAP=
AI_MODEL_STANDARD=

# --- MCP yönetici asistanı ---
# `/mcp` ucunun Bearer anahtarı; yoksa uç kapalıdır, yapılandırılmamış süreç kapıyı açmaz. Üretme: openssl rand -hex 32
MCP_CONNECTION_KEY=

# --- Push: Expo ---
# Backend cron'ları da bildirim yollar (davet, bölge), web ile aynı değişkeni okur. Opsiyonel: yalnız "Enhanced Push Security" açıksa gerekir.
EXPO_ACCESS_TOKEN=

# --- Tarayıcı bildirimi (VAPID anahtar çifti) ---
# Web ile aynı çift, çünkü abonelik açık anahtara bağlıdır. Boşsa tarayıcı sürücüsü yeteneksizdir ve haber sıradaki kanala düşer.
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# --- Bildirim saklaması ---
# Görülmüş personel bildirim satırının saklama süresi (gün), varsayılan 90. Görülmemiş satır ve müşteri satırı hiç süpürülmez.
NOTIFICATION_RETENTION_DAYS=90

# --- Sendcloud / kargo ---
# Sağlayıcıyı kuran her süreç anahtarı kendi ortamında görmeli: web, backend ve mobile-api. Yoksa akış durur ve söyler: eşik altı
# kargo siparişi açılmaz, cron `not_configured` bırakır, mobil uç `503 shipping_provider_off` döner.
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=
# Opsiyonel: sağlayıcı adresi, boşsa `https://panel.sendcloud.sc`.
SENDCLOUD_API_BASE_URL=

# Webhook imzası (`Sendcloud-Signature`, HMAC-SHA256 hex); webhook'u yalnız backend alır ve boşsa uç 503 döner. Panelde ayrı
# "Webhook Signature Key" yoksa gizli anahtar imzalar ve bu alan boş kalabilir.
SENDCLOUD_WEBHOOK_SECRET=

# Opsiyonel: takılı gönderi eşiği (saat), boşsa 24. Bu süreden eski açık gönderiler sağlayıcıya yeniden sorulur.
SHIPMENT_STUCK_HOURS=

# --- Sertifikalı kasa (Hiboutik) ---
# Kasa eşitlemesini yalnız backend koşar; anahtar yoksa tur `not_configured` bırakır. Anahtar varsa tesisin satışı, tesis kurulum
# kartında kasa mağazasına eşlendiği andan itibaren kasaya yazılır.
# Ayarlar › Kurulum › Bağlantı anahtarları'ndan yazılan anahtar bu değerin yerine geçer.
HIBOUTIK_ACCOUNT=
HIBOUTIK_USER=
HIBOUTIK_API_KEY=
# `live` dışında gün kapanışı yapılmaz (mali kayıttır, geri alınmaz); mutabakat yine koşar. Demo hesap kapanışı zaten reddeder.
HIBOUTIK_MODE=
# Opsiyonel: gün sonunun saati (`HH:MM`, Paris), boşsa 00:15; o saatte önceki gün kapatılır.
REGISTER_CLOSE_AT=
# Opsiyonel: bugünün kapatmadan karşılaştırılma zamanı (cron ifadesi, Paris), boşsa `40 8-20/2 * * *`. Her tur kasaya mağaza başına
# dört çağrı yapar; kasa API'sinin aylık kotası satış yazımıyla ortaktır.
REGISTER_CHECK_CRON=

# --- Muhasebe yazılımı (Pennylane) ---
# Banka hareketini yalnız backend okur; anahtar ya da kip yoksa tur `not_configured` bırakır. Banka hesabının hareketleri, hesap kurulum
# kartında Pennylane'deki hesaba eşlendiği günden itibaren okunur.
# Ayarlar › Kurulum › Bağlantı anahtarları'ndan yazılan anahtar bu değerin yerine geçer.
PENNYLANE_API_TOKEN=
# `sandbox` test şirketine, `live` canlı şirkete bağlanır; kip anahtarın şirketiyle uyuşmazsa hiçbir istek gitmez.
PENNYLANE_MODE=

# --- Ödeme sağlayıcı (Revolut) ---
# Merchant API anahtarları (Revolut Business › Merchant › Merchant API). `sandbox` deneme ortamına, `live` canlı hesaba bağlanır.
# Ödeme zamanlayıcısı sağlayıcıya yalnız sorar (taslağın ödemesi, iptali, iadesi); boşsa sormadan geçer, değer web ile aynı.
# Ayarlar › Kurulum › Bağlantı anahtarları'ndan yazılan anahtar bu değerin yerine geçer.
REVOLUT_SECRET_KEY=
REVOLUT_PUBLIC_KEY=
REVOLUT_MODE=
# Tap to Pay on iPhone: Developer Portal uygulamasının canlı ve deneme Client ID'si, izin dönüş adresi ve sertifika klasörü
# (`private.key`, `signing.der`, `transport.der`; depo dışında tutulur). SDK deneme ortamını desteklemez.
REVOLUT_TAP_TO_PAY_CLIENT_ID=
REVOLUT_TAP_TO_PAY_SANDBOX_CLIENT_ID=
REVOLUT_TAP_TO_PAY_REDIRECT_URI=
REVOLUT_TAP_TO_PAY_CERT_DIR=

# --- İzleme ---
# MCP asistan ucunun dakika başına istek tavanı (`mcp/rate-limit.ts`), boşsa koddaki varsayılan.
MCP_RATE_LIMIT_PER_MINUTE=
# Sağlık toplayıcısının TLS sertifikasını sorduğu alan adı (`collect-health.ts`). Boşsa ölçüm atlanır ve `unknown` görünür, "sağlıklı" değil.
SITE_HOST=
# Web'in sağlık yoklaması için portu (`collect-health.ts`), boşsa 3000.
WEB_HEALTH_PORT=
# WhatsApp gönderim jetonu; web ile aynı değişken.
META_ACCESS_TOKEN=

# --- Meta webhook: `GET/POST /webhooks/meta` (kabuk `src/webhooks/meta.ts`, işleyici `@lezzet/application`) ---
# Eksik anahtarda uç 503 döner: doğrulanamayan gövde işlenmez.

# Gelen olayın imzası (`X-Hub-Signature-256`) bununla doğrulanır; imzasız uca "şu numaradan geliyorum" diyen kimlik kurgusunu bozardı.
META_APP_SECRET=
# Kurulum el sıkışmasının bizim seçtiğimiz dizesi; eşleşmesi adresi bizim yazdığımızın kanıtıdır.
META_WEBHOOK_VERIFY_TOKEN=
# Kalıcı Cloudflare tüneli (`pnpm tunnel`): yerel backend'i `https://api-dev.lezzetanatolie.com`a çıkarır, Meta webhook'u bir kez
# kaydedilir. Jeton tünelin sahipliğidir ve komut satırına yazılmaz; yoksa çare quick tunnel (`cloudflared tunnel --url`).
CLOUDFLARE_TUNNEL_TOKEN=
# Sayfa jetonu: Messenger ve Instagram gönderimi ve gönderenin görünen adı. Yoksa gönderim sistem jetonuna düşer ve sohbet adsız açılır;
# değer apps/web/.env.local ile aynı.
META_PAGE_ACCESS_TOKEN=
# Facebook Sayfa kimliği; yalnız `pnpm meta:register` okur, webhook gövdesindeki `entry[].id` ile aynıdır.
META_PAGE_ID=

# --- R2 dosya deposu: sohbetten gelen medya ---
# Değerler apps/web/.env.local ile aynı, iki uygulama aynı kovayı kullanır. Yoksa gelen fotoğraf ve ses saklanmaz, sesli mesaj metne
# çevrilmez; sohbet çalışmaya devam eder.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Şikâyet fotoğrafı, teslim kanıtı ve sohbet medyası bu kovada; public adresi yoktur, okuma süreli imzalı adresle (`privateReadUrl`).
R2_PRIVATE_BUCKET_NAME=
R2_PATH_PREFIX=
R2_PUBLIC_BASE_URL=

# --- Site adresi ---
# Ajanın sohbete yazdığı sepet bağlantısı ve mail bağlantılarının tabanı. Yoksa kod üretim alanına düşer ve yerelde bağlantı canlı
# siteye gider; yerelde `http://localhost:3000`.
NEXT_PUBLIC_SITE_URL=

