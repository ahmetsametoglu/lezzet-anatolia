# apps/backend — env örneği. Gerçek değerler apps/backend/.env.local'de tutulur (git-ignored).
# Backend'e özgü yapılandırma buraya; kök .env yalnız root araçları (script/test/supabase CLI) içindir.

# Dinlenecek port (yoksa 8787).
BACKEND_PORT=8787

# --- Supabase (service-role; cron'lar RLS baypas ile yazar) ---
# Backend Next.js DEĞİL: env'i kendi .env.local'inden okur. Eksikse `serviceDb()` ilk cron turunda
# "Supabase env eksik" ile patlar — sessiz değil, anlaşılır bir hatayla.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Yapay zekâ: kullanıcı metni çevirisi (20.2 · packages/ai) ---
# Beş dakikada bir koşan çeviri cron'u kullanır. Anahtar YOKSA tur kendini atlar ve HİÇBİR SATIRI
# DAMGALAMAZ — anahtar sonradan geldiğinde geçmişin tamamı çevrilebilir kalsın diye (bu bilinçli:
# "denendi, olmadı" damgası atmak, kurulum eksikliğini kalıcı bir veri kaybına çevirirdi).
# AI_PROVIDER: anthropic (varsayılan) | google — YALNIZ seçilenin anahtarı gerekir.
AI_PROVIDER=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Katman modelleri; boşsa sağlayıcının varsayılanı. Çeviri `cheap`e gider: hacimli ve tek doğrusu
# olan bir iş, pahalı katmanın ekleyeceği bir şey yok.
AI_MODEL_CHEAP=
AI_MODEL_STANDARD=
