# Yerel geliştirme örneği — kopyala: cp .env.example .env
# EXPO_PUBLIC_* değişkenleri Metro tarafından DERLEME anında bundle'a gömülür:
# buraya YALNIZ istemciye açık değerler yazılır (anon anahtar evet, secret ASLA).

# apps/mobile-api taban adresi (yerel varsayılan port 3002; cihazdan test ederken makinenin LAN IP'si)
EXPO_PUBLIC_API_URL=http://localhost:3002

# Yerel Supabase (supabase start çıktısındaki API URL + anon/publishable key)
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_KEY=anon-anahtari-buraya

# Sitenin dış dünyaya görünen adresi — davet bağlantısının açılacağı alan adı (21.43).
# YERELDE BOŞ BIRAKILIR: `localhost` bir alan adı değildir, ilişkilendirilemez ve uydurma bir
# değer, işletim sisteminin BAŞARISIZ doğrulamayı önbelleğe almasına yol açar (app.config.ts
# künyesi). Dolduğunda uygulama `https://<alan-adı>/<dil>/davet/<kod>` adreslerini sahiplenir;
# karşılığı web'in `/.well-known/*` dosyalarıdır. Boşken davet bağlantısı tarayıcıda açılır ve
# akış yine çalışır.
EXPO_PUBLIC_SITE_URL=

# Stripe istemci anahtarı — cihazda kullanılır, `EXPO_PUBLIC_` öneki bilinçli (pakete girer).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Apple Pay tüccar kimliği (`app.config.ts`). Boşsa Apple Pay yapılandırması hiç eklenmez.
EXPO_PUBLIC_STRIPE_APPLE_MERCHANT_ID=
