{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // TS 6 `@types`'ı otomatik dahil etmiyor; jest globalleri (describe/it/expect) açıkça bildirilir.
    // `node`: app.config bekçisi (`app-config-guard.test.ts`) dosya okur — testler zaten node
    // ortamında koşuyor; RN kodu node API'si çağırırsa Metro'da yine kırılır, tsc'ye güvenilmez.
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "dist"]
}
