# apps/mobile-api — env örneği. Gerçek değerler apps/mobile-api/.env.local'de tutulur (git-ignored).
# Mobile-api Next.js DEĞİL: env'i `src/env.ts` ilk import'ta buradan yükler (apps/backend deseni).

# Dinlenecek port (yoksa 3002; backend 8787'de, web 3000'de — çakışmaz).
MOBILE_API_PORT=3002

# --- Supabase ---
# Yerel yığının değerleri (`supabase status -o env`); kök .env ile aynı.
# PUBLISHABLE anahtar Bearer token doğrulaması için (auth.getUser — en az yetki),
# SECRET anahtar veri okumaları için (servisler RLS baypas ile okur; yalnız sunucuda, ASLA mobil bundle'da).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
