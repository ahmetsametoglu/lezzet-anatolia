# apps/mobile-api env örneği; gerçek değerler git'e girmeyen apps/mobile-api/.env.local'de. Next.js değildir, env'i `src/env.ts`
# ilk import'ta buradan yükler.

# Dinlenecek port (yoksa 3002; backend 8787'de, web 3000'de).
MOBILE_API_PORT=3002

# --- Supabase ---
# Yerel yığının değerleri (`supabase status -o env`). Publishable anahtar Bearer jetonunu doğrular, secret anahtar RLS'yi baypas
# ederek okur ve mobil pakete asla girmez.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Sabit dev OTP kodu ---
# Yoksa gerçek rastgele kod maille gider ve cihazda OTP isteyen akış yürütülemez; üretimde kapı kendini kapatır, altı rakam
# değilse yok sayılır. BEKLEYEN(18.13): savunması tek bir `NODE_ENV` okumasına dayandığı için üretime çıkmadan sökülecek.
OTP_TEST_CODE=123456

# --- R2 (yalnız okuma yolu) ---
# Katalog görselinin adresi taban adres ve dev/prod önekiyle kurulur; bu servis dosya yüklemediği için kimlik bilgisi almaz. Boşsa
# `image.url` null döner ve kart görselsiz çizilir.
R2_PUBLIC_BASE_URL=
R2_PATH_PREFIX=dev

# --- Sendcloud / kargo ---
# Sağlayıcıyı kuran her süreç anahtarı kendi ortamında görmeli: web, backend ve mobile-api (native ödeme teklifi, depocunun etiket
# satın alma ucu). Yoksa akış durur ve söyler: eşik altı kargo siparişi açılmaz, mobil uç `503 shipping_provider_off` döner.
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=
# Opsiyonel: sağlayıcı adresi, boşsa `https://panel.sendcloud.sc`.
SENDCLOUD_API_BASE_URL=

# Ödeme niyeti sunucuda açılır; yoksa ödeme `provider_unavailable` döner.
STRIPE_SECRET_KEY=

# --- Meta / WhatsApp gönderim jetonu ---
# Sosyal sohbetin cevap ucu mesajı gerçekten gönderir; jeton yoksa akıbet `failed · not_configured` olur ve ekran "gönderilemedi" der.
# Gönderen işletme hesabı buradan değil konuşmanın kaydından gelir, yoksa kurulum tek hesaba kilitlenirdi.
META_ACCESS_TOKEN=

# --- Google Maps Platform: adres önerisi ve doğrulama (`src/api/v1/addresses.ts`) ---
# Sunucu anahtarı (Places API (New) + Address Validation API), web'deki `GOOGLE_MAPS_API_KEY` ile aynı değer. Boşsa Almanya'da
# öneri yok ve doğrulama susar; form elle girişle çalışır, sipariş durmaz.
GOOGLE_MAPS_API_KEY=

# --- AI sağlayıcısı: kurumsal başvuru özeti ---
# `AI_PROVIDER` atlanmamalı: varsayılan `anthropic` olduğu için yalnız Google anahtarı konmuş kurulum anahtar dururken reddedilir.
# Yapılandırılmamışsa uç `summary: null` döner ve kart yardımsız ama eksiksiz çizilir.
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=

# Katman varsayılanlarını ezer; koddaki varsayılan liste sağlayıcı modeli emekliye ayırınca bayatlar, adı env'de tutmak sessiz
# sağlayıcı hatasından iyidir.
AI_MODEL_CHEAP=gemini-3.5-flash-lite
AI_MODEL_STANDARD=gemini-3.5-flash

# Messenger / Instagram cevabının Sayfa jetonu; WhatsApp jetonu bu iki kanalda çalışmaz. Yoksa Messenger/IG cevabı `failed` döner,
# WhatsApp etkilenmez.
META_PAGE_ACCESS_TOKEN=
