# apps/mobile-api — env örneği. Gerçek değerler apps/mobile-api/.env.local'de tutulur (git-ignored).
# Mobile-api Next.js DEĞİL: env'i `src/env.ts` ilk import'ta buradan yükler (apps/backend deseni).

# Dinlenecek port (yoksa 3002; backend 8787'de, web 3000'de — çakışmaz).
MOBILE_API_PORT=3002

# --- Supabase ---
# Yerel yığının değerleri (`supabase status -o env`); kök .env ile aynı.
# PUBLISHABLE anahtar Bearer token doğrulaması için (auth.getUser — en az yetki),
# SECRET anahtar veri okumaları için (servisler RLS baypas ile okur; yalnız sunucuda, ASLA mobil bundle'da).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Deterministik dev OTP kodu ---
# Kök `.env` bunu taşıyor ve web/e2e kullanıyordu; mobile-api'nin env'inde YOKTU (ölçüldü 14.08,
# cihaz turunda: kod isteniyor, "gönderdik" deniyor, girilen kod hep "yanlış" çıkıyordu — çünkü
# gerçek rastgele kod üretilip Resend'e veriliyordu ve kimse okuyamıyordu). Sonucu şuydu:
# NATIVE'DE OTP GEREKTİREN HİÇBİR AKIŞ CİHAZDA YÜRÜTÜLEMİYORDU.
# Kapı kendini üretimde kapatır (`NODE_ENV === 'production'` → kod yok) ve değer tam altı rakam
# değilse sessizce yok sayılır — gerekçesi `packages/application/src/auth/otp.ts` künyesinde.
# Boş bırakılırsa gerçek kod üretilir ve mail gider (üretim davranışı).
# BEKLEYEN(18.13): bu kapı üretime çıkmadan SÖKÜLECEK (kullanıcı kararı 15.08) — bugün gerçek bir
# ihtiyaç, ama savunması tek bir `NODE_ENV` okumasına dayanıyor ve yanlış yapılandırılırsa kimlik
# doğrulaması sabit koda düşer. Bitti kriteri `docs/build/18-operasyon-guvenlik.md` (18.13).
OTP_TEST_CODE=123456

# --- R2 (yalnız OKUMA yolu) ---
# Katalog görselinin public URL'i `publicImageUrl` ile kurulur (@lezzet/storage) ve iki değer ister:
# taban adres + dev/prod izolasyon öneki. Kimlik bilgisi YOK — yazma yolu (R2_ACCESS_KEY_ID vb.)
# mobile-api'ye hiç girmez: bu servis dosya yüklemez, yalnız var olan anahtarı adrese çevirir.
# Boş bırakılırsa uç çökmez, `image.url` null döner (graceful degradation — kart görselsiz çizilir).
R2_PUBLIC_BASE_URL=
R2_PATH_PREFIX=dev

# --- Sendcloud / kargo (07.12) ---
# Anahtarlar TEK yerde okunuyor: `packages/application/src/shipping/provider.ts` →
# `sendcloudProvider()`. Kütüphane ortak (`@lezzet/sendcloud` + `application/shipping`), ortak
# OLMAYAN tek şey bu env — provider'ı kuran her SÜREÇ anahtarları kendi ortamında görmek zorunda.
# Bugün üç süreç kuruyor: web (checkout teklifi) · backend (webhook + nöbet cron'ları) ·
# mobile-api (depocunun etiket satın alma ucu).
#
# Anahtar YOKSA akış sessizce çalışmaz, DURUR ve söyler: teklif sabit tarifeye düşer ve düştüğünü
# ekrana yazar, cron turu `{ skipped: 'not_configured' }` bırakır, mobil uç `503
# shipping_provider_off` döner. Sessiz no-op yok (CLAUDE §1).
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=
# OPSİYONEL — sağlayıcı adresini değiştirmek için. Boşsa `https://panel.sendcloud.sc`.
SENDCLOUD_API_BASE_URL=

# Stripe gizli anahtarı — ödeme niyeti sunucuda açılır, anahtar sunucuda kalır. Yoksa ödeme akışı
# `provider_unavailable` döner; sessiz başarı yok.
STRIPE_SECRET_KEY=

# --- Meta / WhatsApp gönderim jetonu (21.286) ---
# Sosyal sohbetin cevap ucu (`/api/v1/social/conversations/:id/reply`) mesajı GERÇEKTEN gönderiyor;
# sürücüyü `messageSenderFor(process.env.META_ACCESS_TOKEN)` seçiyor. Jetonu ÇAĞIRAN okur, paket
# değil (`STACK §4`: `@lezzet/application` `process.env` bilmez) — aynı motor web'de de aynı şekilde
# besleniyor.
#
# YOKSA sessiz no-op yok: `messageSenderFor` reddeden sürücüyü döndürür, akıbet `failed ·
# not_configured` olur ve ekran "gönderilemedi" der. Operatör gönderdiğini SANMAZ.
#
# Gönderilecek işletme hesabı buradan GELMEZ: o, konuşmanın `providerAccountRef`i (webhook'tan
# yazılır) — env'e sabitlemek, birden çok hesabı olan bir kurulumu tek hesaba kilitlerdi.
META_ACCESS_TOKEN=

# --- Asistan özeti / AI sağlayıcısı (21.285) ---
# Kurumsal başvuru kartındaki tek cümlelik OKUMA YARDIMI (`/api/v1/management/b2b/:id/summary`).
#
# ÜÇÜ BİRDEN GEREKİYOR ve `AI_PROVIDER`ı atlamak sessiz bir tuzak: `resolveModel`ın varsayılanı
# `anthropic` (`packages/ai/src/provider.ts`), yani yalnız Google anahtarını koyup sağlayıcıyı
# yazmayan bir kurulum `ANTHROPIC_API_KEY tanımlı değil` diye reddedilir — anahtar DURURKEN.
# Web ve backend de aynı üçlüyü taşıyor (`apps/{web,backend}/.env.local`).
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=

# Katman varsayılanlarını EZER. Özet `cheap` katmanda koşuyor: altı sinyali tek cümleye indirmek
# yorum derinliği istemiyor. Boşsa `provider.ts`teki varsayılan kullanılır — ama o liste bayatlıyor
# (ölçüldü 07.09: `gemini-2.5-flash-lite` "no longer available to new users" ile reddedildi), o
# yüzden model adını env'de tutmak sessiz bir sağlayıcı hatasından iyidir.
AI_MODEL_CHEAP=gemini-3.5-flash-lite
AI_MODEL_STANDARD=gemini-3.5-flash

# Anahtar/sağlayıcı YOKSA çağrı `not_configured` diye reddeder, uç 200 + `summary: null` döner ve
# kart bugüne kadarki dürüst hâlinde kalır ("Özet üretilemedi — sinyalleri yukarıdan okuyun").
# Yani yapılandırmasız kurulumda ekran EKSİK DEĞİL, yalnız yardımsızdır — kararın dayanağı olan
# sinyaller motordan geliyor ve onlar her hâlde yerinde.
