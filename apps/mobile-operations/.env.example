# Yerel geliştirme örneği — kopyala: cp .env.example .env
# EXPO_PUBLIC_* değişkenleri Metro tarafından DERLEME anında bundle'a gömülür:
# buraya YALNIZ istemciye açık değerler yazılır (anon anahtar evet, secret ASLA).
# Operasyon uygulaması yalnız bu dördünü okur; site adresi ve Stripe anahtarları müşteri uygulamasınındır.

# apps/mobile-api taban adresi (yerel varsayılan port 3002).
# CİHAZDAN TEST EDERKEN ELLE LAN IP YAZMAYIN (30.08): `localhost` yazılı kalır ve host'u kod
# çözer — cihaz Metro'ya hangi adresten bağlandıysa API ve Supabase de oraya gider
# (`packages/mobile-kit/src/lib/env.ts`). iOS simülatörü ve `adb reverse`li Android `localhost`ta
# kalır, iOS fiziksel cihaz makinenin o anki LAN adresini kullanır.
EXPO_PUBLIC_API_URL=http://localhost:3002

# Yerel Supabase (supabase start çıktısındaki API URL + anon/publishable key)
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_KEY=anon-anahtari-buraya

# Otomatik geliştirme girişi — YALNIZ `__DEV__` derlemesinde okunur
# (`packages/mobile-kit/src/lib/auth/use-dev-auto-login.hook.ts`). Boş/tanımsızken AÇIKTIR: uygulama
# oturumsuz açıldığında dört bölümü de gören personel hesabıyla (`hepsi@lezzetanatolie.com`, seed)
# sessizce giriş yapar — geliştirme günü boyunca `db:refresh` oturumu defalarca geçersizleştirdiği için var.
# `off` yazılırsa kapanır; giriş akışının kendisini denemek isteyen bunu kapatır. Üretimde etkisi yoktur.
EXPO_PUBLIC_DEV_AUTOLOGIN=
