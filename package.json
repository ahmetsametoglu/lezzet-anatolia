{
  "name": "lezzet-anatolia",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @lezzet/web run dev",
    "dev:backend": "pnpm --filter @lezzet/backend run dev",
    "build": "turbo run build",
    "build:web": "pnpm --filter @lezzet/web run build",
    "build:backend": "pnpm --filter @lezzet/backend run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "depcruise apps packages",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@lezzet/eslint-config": "workspace:*",
    "@lezzet/typescript-config": "workspace:*",
    "dependency-cruiser": "^16.8.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
