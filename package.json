{
  "name": "lezzet-anatolia",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @lezzet/web run dev",
    "dev:backend": "pnpm --filter @lezzet/backend run dev",
    "build": "turbo run build",
    "build:web": "pnpm --filter @lezzet/web run build",
    "build:backend": "pnpm --filter @lezzet/backend run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck && tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "depcruise packages apps/backend apps/mobile-api && pnpm -C apps/web exec depcruise --config ../../.dependency-cruiser.cjs --ts-config tsconfig.json .",
    "knip": "knip",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:sync": "node scripts/docs-check.mjs --fix",
    "postal:build": "node scripts/build-postal-codes.mjs",
    "lezza:catalog": "node scripts/build-lezza-catalog.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "test": "node scripts/shared-test-run.mjs",
    "test:status": "node scripts/shared-test-run.mjs --status",
    "test:e2e": "node scripts/with-test-lock.mjs pnpm exec playwright test",
    "ui:shot": "node scripts/ui-shot.mjs",
    "test:unit": "vitest run --project unit",
    "test:integration": "node scripts/with-test-lock.mjs pnpm exec vitest run --project integration",
    "test:purge": "node scripts/with-test-lock.mjs --kind=ddl tsx scripts/test-purge.ts",
    "test:watch": "vitest --project unit",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "node scripts/with-test-lock.mjs --kind=ddl supabase db reset",
    "db:migrate": "node scripts/with-test-lock.mjs --kind=ddl supabase migration up",
    "db:new": "supabase migration new",
    "db:seed": "tsx scripts/seed.ts",
    "db:refresh": "node scripts/with-test-lock.mjs --kind=ddl sh -c \"supabase db reset && tsx scripts/seed.ts\"",
    "set-role": "tsx scripts/set-role.ts",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "stripe:smoke": "tsx scripts/stripe-smoke.ts"
  },
  "devDependencies": {
    "@lezzet/database": "workspace:*",
    "@lezzet/domain-core": "workspace:*",
    "@lezzet/eslint-config": "workspace:*",
    "@lezzet/helper": "workspace:*",
    "@lezzet/storage": "workspace:*",
    "@lezzet/types": "workspace:*",
    "@lezzet/typescript-config": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.5",
    "dependency-cruiser": "^16.8.0",
    "eslint": "^9.17.0",
    "knip": "^5.30.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
