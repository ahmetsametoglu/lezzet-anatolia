{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": [
    "supabase",
    "stripe",
    "maestro"
  ],
  "ignore": [
    "design/**"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "e2e/setup/*.setup.ts",
        "ecosystem.config.cjs"
      ]
    },
    "apps/web": {
      "entry": [
        "lib/guard.ts"
      ],
      "ignoreDependencies": [
        "pino",
        "pino-pretty"
      ]
    },
    "packages/domain-core": {
      "includeEntryExports": true
    },
    "packages/address": {
      "includeEntryExports": true
    },
    "packages/application": {
      "ignoreDependencies": [
        "@expo-google-fonts/karla"
      ]
    },
    "apps/mobile-customer": {
      "entry": [
        "src/testing/expo-image-picker.mock.ts"
      ]
    },
    "apps/mobile-operations": {
      "entry": [
        "src/testing/expo-audio.mock.ts"
      ]
    },
    "packages/mobile-kit": {
      "babel": true,
      "entry": [
        "src/testing/gorhom-bottom-sheet.mock.tsx",
        "src/lib/settings/font-scale.ts",
        "src/components/customer/customer-metrics.ts",
        "src/lib/auth/error-text.ts"
      ]
    }
  },
  "ignoreExportsUsedInFile": true
}
