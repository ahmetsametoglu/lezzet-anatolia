{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": [
    "supabase",
    "stripe",
    "maestro"
  ],
  "ignore": [
    "design/**"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "e2e/setup/*.setup.ts"
      ]
    },
    "apps/web": {
      "entry": [
        "lib/guard.ts"
      ]
    },
    "packages/domain-core": {
      "includeEntryExports": true
    },
    "apps/mobile": {
      "entry": [
        "src/testing/gorhom-bottom-sheet.mock.tsx"
      ]
    }
  },
  "ignoreExportsUsedInFile": true
}
